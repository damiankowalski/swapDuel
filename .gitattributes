# Text files are stored and checked out with LF on every OS (macOS and Windows alike).
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.glb binary
*.gltf binary
*.bin binary
*.ogg binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
