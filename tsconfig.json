{
  // Node side: the server, tests, tools, the client's pure animation curves and the Vite config (Node runs the .ts files directly).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "tools/**/*.ts", "client/src/anim.ts", "client/src/anim.test.ts", "vite.config.ts"]
}
